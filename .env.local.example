# Leave empty for relative API calls in production / on Pages.
# Set to http://localhost:8788 only if you run the frontend separately from `wrangler pages dev`.
NEXT_PUBLIC_API_URL=

# Cloudflare Turnstile keys (use test keys for development)
# Test secret key: 1x0000000000000000000000000000000AA
# Test site key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
